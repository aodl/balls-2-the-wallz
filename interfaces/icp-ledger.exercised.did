// Manually transcribed EXERCISED SUBSET, not a byte-for-byte upstream snapshot.
// Reference: dfinity/ic @ d3b3351fa343a893aea2cfa8d39ac6b0d507b477,
// rs/ledger_suite/icp/ledger.did. See docs/IC_REFERENCES.md.
type Tokens = record { e8s : nat64 };
type TimeStamp = record { timestamp_nanos : nat64 };
type AccountIdentifier = blob;
type Operation = variant {
  Mint : record { to : AccountIdentifier; amount : Tokens };
  Burn : record { from : AccountIdentifier; spender : opt AccountIdentifier; amount : Tokens };
  Transfer : record { from : AccountIdentifier; to : AccountIdentifier; amount : Tokens; fee : Tokens; spender : opt blob };
  Approve : record { from : AccountIdentifier; spender : AccountIdentifier; allowance_e8s : int; allowance : Tokens; fee : Tokens; expires_at : opt TimeStamp; expected_allowance : opt Tokens };
};
type Transaction = record { memo : nat64; icrc1_memo : opt blob; operation : opt Operation; created_at_time : TimeStamp };
type Block = record { parent_hash : opt blob; transaction : Transaction; timestamp : TimeStamp };
type GetBlocksArgs = record { start : nat64; length : nat64 };
type QueryArchiveError = variant {
  BadFirstBlockIndex : record { requested_index : nat64; first_valid_index : nat64 };
  Other : record { error_code : nat64; error_message : text };
};
type BlockRange = record { blocks : vec Block };
type QueryArchiveResult = variant { Ok : BlockRange; Err : QueryArchiveError };
type QueryArchiveFn = func (GetBlocksArgs) -> (QueryArchiveResult) query;
type ArchivedBlocksRange = record { start : nat64; length : nat64; callback : QueryArchiveFn };
type QueryBlocksResponse = record {
  chain_length : nat64; certificate : opt blob; blocks : vec Block; first_block_index : nat64; archived_blocks : vec ArchivedBlocksRange;
};
service : {
  query_blocks : (GetBlocksArgs) -> (QueryBlocksResponse) query;
  icrc1_fee : () -> (nat) query;
  icrc1_supported_standards : () -> (vec record { name : text; url : text }) query;
}
