type Completion = record {
  block_index : nat64;
  completed_at_ns : nat64;
  plan : Plan;
  cycles : text;
};
type ControllerWork = record {
  source_cursor : nat64;
  ready_manifest : opt text;
  phase : opt text;
  revision : nat64;
  pending_inputs : nat32;
};
type DriverMetrics = record {
  last_persist_instructions : nat64;
  last_publish_instructions : nat64;
  last_seal_instructions : nat64;
  last_step_instructions : nat64;
  last_instructions : nat64;
  messages : nat64;
  max_actions : nat32;
  persist_instructions : nat64;
  seal_instructions : nat64;
  step_instructions : nat64;
  publish_instructions : nat64;
  max_instructions : nat64;
};
type Hint = record {
  nominal_milli : nat32;
  supported_milli : nat32;
  performance_limited : bool;
  mode : text;
  admission_open : bool;
};
type IndexConfig = record {
  receiving_subaccount : nat64;
  // Explicitly process existing history too; never silently skip a funded account.
  starting_policy : StartingPolicy;
  event_horizon : opt principal;
  network : text;
  ledger : principal;
  index : principal;
};
type Observation = record { e8s : nat64; observed_at_ns : nat64 };
type Observation_1 = record { certificate : opt blob; publication : blob };
type ObservationBundle = record {
  observation : Observation_1;
  artifacts : vec blob;
};
type Phase = variant {
  NotifyPending : record { block_index : nat64; plan : Plan; attempts : nat64 };
  Idle;
  TransferPending : record { plan : Plan; attempts : nat64; uncertain : bool };
};
type Plan = record {
  to : blob;
  cmc : text;
  created_at_time_ns : nat64;
  beneficiary : text;
  memo : nat64;
  fee_e8s : nat64;
  amount_e8s : nat64;
  ledger : text;
};
type PokeMatch = record { target : PokeTarget; max_amount : nat };
type PokeTarget = variant { neuron_nonce : nat64; subaccount : nat64 };
type Refund = record {
  plan : Plan;
  refund_block : opt nat64;
  transfer_block : nat64;
  reason : text;
};
type Result = variant { Ok : blob; Err : text };
type Result_1 = variant { Ok : State; Err : text };
type Result_2 = variant { Ok : RuntimeDiagnostics; Err : text };
type Result_3 = variant { Ok : ControllerWork; Err : text };
type Result_4 = variant { Ok : Status; Err : text };
type Result_5 = variant { Ok : Observation_1; Err : text };
type Result_6 = variant { Ok : RetentionStatus; Err : text };
type Result_7 = variant { Ok : vec blob; Err : text };
type Result_8 = variant { Ok : ObservationBundle; Err : text };
type RetainedEntry = record {
  segment_id : nat64;
  bytes : nat64;
  current : bool;
  publication_hash : text;
};
type RetentionStatus = record {
  entries : vec RetainedEntry;
  max_segments : nat16;
  max_bytes : nat64;
  retained_bytes : nat64;
};
type RunConfig = record {
  work_budget : nat32;
  segment_ticks : nat64;
  pacing_seconds : nat32;
};
type RunStatus = record {
  last_error : opt text;
  last_segment_work : nat64;
  callback_count : nat64;
  world_transition : bool;
  idle : bool;
  pace : Hint;
  generation : nat64;
  work_budget : nat32;
  total_work : nat64;
  current_segment_work : nat64;
  segment_ticks : nat64;
  publication_ticks : nat64;
  max_segment_work : nat64;
  completed_segments : nat64;
  running : bool;
  pacing_seconds : nat32;
};
type RuntimeDiagnostics = record {
  metrics : DriverMetrics;
  instruction_yield : nat64;
  message_work_limit : nat64;
  total_cycles : nat;
  phase_action_limit : nat32;
  liquid_cycles : nat;
};
type SourceStatus = record {
  last_error : opt text;
  receiving_subaccount : nat64;
  index_calls : nat64;
  binding_checked : bool;
  reconciliation_requested : bool;
  event_horizon : opt principal;
  network : text;
  pending_records : nat32;
  ledger : principal;
  index : principal;
  recipient_account : blob;
  admitted_to_exclusive : nat64;
  scan_in_flight : bool;
};
type StartingPolicy = variant { FromBeginning };
type State = record {
  last_error : opt text;
  total_cycles_reported : text;
  last_plan_ns : nat64;
  observed_fee : opt Observation;
  last_refund : opt Refund;
  total_converted_e8s : text;
  last_success : opt Completion;
  version : nat32;
  lease_started_ns : nat64;
  nonce : nat64;
  observed_balance : opt Observation;
  halted : bool;
  phase : Phase;
  paused : bool;
};
type Status = record {
  run : RunStatus;
  source : SourceStatus;
  version : nat32;
  revision : nat64;
  publication_hash : text;
};
service : (blob, nat64, IndexConfig) -> {
  artifact_bundle : (nat64, text) -> (Result_7) query;
  artifact_chunk : (text, nat8, nat16) -> (Result) query;
  // Commit the reviewed compact 1000×1000 state through DTR's generic next
  // epoch operation. No state or identity is accepted from the caller.
  commit_million_transition : (text) -> (Result);
  // Derive the new world from the actual durable committed state, once. Expected
  // manifest protects against a stale operator view; there is no arbitrary replacement.
  commit_torus_transition : (text) -> (Result);
  controller_funding : () -> (Result_1) query;
  controller_runtime : () -> (Result_2) query;
  controller_work : () -> (Result_3) query;
  lab_status : () -> (Result_4) query;
  million_transition_status : () -> (Result) query;
  observation : () -> (Result_5) query;
  observation_bundle : () -> (Result_8) query;
  pause_autonomous : () -> (Result_4);
  poke : (vec PokeMatch) -> ();
  // Begins only the reviewed v4→v5 cutover. The existing v3→v4 evidence is
  // retained independently, and the worker obtains fresh global watermarks.
  prepare_million_transition : () -> (Result);
  // Begins only the reviewed v3→v4 cutover. Never accepts state, identities or a
  // caller-supplied Ledger height. The fenced worker obtains its own watermarks.
  prepare_torus_transition : () -> (Result);
  retained_artifact_chunk : (nat64, text, nat8, nat16) -> (Result) query;
  retained_publication : (nat64) -> (Result) query;
  retention_status : () -> (Result_6) query;
  set_funding_paused : (bool) -> (Result_1);
  // Hash this descriptor and compare with the certified publication's source_id.
  source_descriptor : () -> (Result) query;
  start_autonomous : (RunConfig) -> (Result_4);
  torus_transition_status : () -> (Result) query;
}
