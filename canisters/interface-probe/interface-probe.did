// Hand-authored intended interface. Generated-Candid equivalence is a BLOCKED gate in S01.
type Info = record {
  checkpoint : text; mode : text; ledger : opt principal; index : opt principal; certified : bool;
};
type MemoObservation = record { legacy : nat64; icrc_blob : opt blob };
type LedgerObservation = record {
  chain_length : nat64; first_returned : opt nat64; returned_blocks : nat64;
  archive_ranges : nat64; memos : vec MemoObservation;
};
type IndexObservation = record { ledger : principal; num_blocks_synced : nat64 };
service : (principal, opt principal) -> {
  info : () -> (Info) query;
  probe_ledger : (nat64, nat64) -> (variant { Ok : LedgerObservation; Err : text });
  probe_index : () -> (variant { Ok : IndexObservation; Err : text });
}
