{
  "version": 1,
  "canisters": {
    "btz": {
      "type": "custom",
      "candid": "canisters/runtime-lab/runtime-lab.did",
      "wasm": "canisters/runtime-lab/target/wasm32-unknown-unknown/release/dtr_runtime_lab.wasm",
      "build": "cargo build --manifest-path canisters/runtime-lab/Cargo.toml --release --target wasm32-unknown-unknown --locked"
    },
    "observer": {
