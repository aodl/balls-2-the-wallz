      "source": [".work/s14/assets/"]
    }
  },
  "networks": {
    "local": { "bind": "127.0.0.1:4943", "type": "ephemeral" },
    "ic": { "providers": ["https://icp-api.io"], "type": "persistent" }
  }
}
